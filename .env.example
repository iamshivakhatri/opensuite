# Copy to .env at the repo root and fill in real values. Never commit .env.
#
# Loaded by apps/api and packages/db via their own load-env.ts (not dotenv),
# which preserves special characters (e.g. a URL-encoded DATABASE_URL
# password) verbatim — see docs/status.md for why.

# PostgreSQL connection string for the OpenSuite database.
DATABASE_URL=postgresql://user:password@host:5432/opensuite

# Secret used by Better Auth to sign sessions/tokens. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# BETTER_AUTH_URL = public base URL of the API (this Fastify service).
# WEB_ORIGIN     = public base URL of the web app (Next.js / Vercel).
# They are different because web and API are separate origins.
#
# Local:
#   BETTER_AUTH_URL=http://localhost:3000
#   WEB_ORIGIN=http://localhost:3001
# Hosted (example):
#   BETTER_AUTH_URL=https://api.your-domain.com
#   WEB_ORIGIN=https://your-app.vercel.app
# Vercel also needs NEXT_PUBLIC_API_URL= same value as BETTER_AUTH_URL.
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3001
# Additional exact first-party browser origins (comma-separated). CORS and
# Better Auth both use this allowlist; never use a wildcard with credentials.
# WEB_ORIGINS=http://localhost:5173

# When false, new email/password sign-ups are rejected (sign-in still works).
# Default true for local. Hosted compose defaults to false — see docs/deploy.md.
# ALLOW_SIGNUP=true

# Production www.opensuite.tech + api.opensuite.tech are same-site, so keep
# this false for Secure, HttpOnly, SameSite=Lax cookies. Use true only for a
# genuinely cross-site frontend and API, both served over HTTPS.
# AUTH_CROSS_ORIGIN=false

# Optional Google OAuth web-client credentials. Set both to enable Google
# sign-in. The OAuth redirect URI is BETTER_AUTH_URL + /api/auth/callback/google.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Fastify log level (default info). Request lines are one-line summaries
# (METHOD url status ms). Use warn to hide routine request noise.
# LOG_LEVEL=info

# Resend (https://resend.com) transactional email — used for account
# verification emails. RESEND_API_KEY must start with "re_".
# EMAIL_FROM can be "OpenSuite <onboarding@resend.dev>" (Resend's shared
# test sender, no domain verification required) until a custom sending
# domain is verified in the Resend dashboard.
RESEND_API_KEY=
EMAIL_FROM=OpenSuite <onboarding@resend.dev>

# S3-compatible object storage (MinIO, AWS S3, R2, …). Application code
# only reads these S3_* names. Legacy MINIO_ENDPOINT / MINIO_ACCESS_KEY /
# MINIO_SECRET_KEY / MINIO_BUCKET are still accepted as fallbacks.
# Optional: MINIO_PORT + MINIO_USE_SSL=true|false when the endpoint has no port.
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=opensuite
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# MINIO_ENDPOINT=http://127.0.0.1
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=opensuite

# Optional max upload size in bytes (default 25 MiB).
# UPLOAD_MAX_BYTES=26214400

# Agent model provider: unconfigured | fake | anthropic | openai | openrouter
# - unconfigured: safe stub (runs fail with MODEL_FAILURE) — default
# - fake: deterministic local model for UI/dev (rejected when NODE_ENV=production)
# - anthropic / openai / openrouter: real providers via AgentModel adapters
AGENT_MODEL_PROVIDER=unconfigured
# V1 preserves the existing agent. Set v2 to use the one-shot OpenRouter stream.

# Required when AGENT_MODEL_PROVIDER=anthropic. Never commit real keys.
# ANTHROPIC_API_KEY=
# Optional model id (default claude-sonnet-4-5).
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Required when AGENT_MODEL_PROVIDER=openai.
# OPENAI_API_KEY=
# Optional model id (default gpt-4.1).
# OPENAI_MODEL=gpt-4.1

# Required when AGENT_MODEL_PROVIDER=openrouter (both key and model slug).
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Managed trial grant in micro-USD (500000 = $0.50) and display credits for UI.
# MANAGED_AI_TRIAL_CREDIT_MICROS=500000
# MANAGED_AI_TRIAL_DISPLAY_CREDITS=100

# Optional overrides for `pnpm agent:bench` (same suite against another provider/model).
# PROVIDER=openrouter
# MODEL=meta-llama/llama-3.3-70b-instruct
# SCENARIO=all
# SCENARIO=simple-read,greenfield-large

# TEMP: agent lifecycle diagnosis — console `[agent-debug]` lines. Remove after diagnosis.
# AGENT_DEBUG_LIFECYCLE=1
