{
  "name": "opensuite",
  "private": true,
  "description": "OpenSuite monorepo — open-source AI-native Office application.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @opensuite/api dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @opensuite/db db:generate",
    "db:migrate": "pnpm --filter @opensuite/db db:migrate",
    "db:check": "pnpm --filter @opensuite/db db:check"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
