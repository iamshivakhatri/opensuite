# Base URL of the apps/api Fastify service (separate origin from apps/web).
# Production: your Dokploy / home-server public HTTPS API URL.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Hide sign-up UI when "false". API still enforces ALLOW_SIGNUP — set both.
# Vercel: Environment Variables → NEXT_PUBLIC_ALLOW_SIGNUP=false
NEXT_PUBLIC_ALLOW_SIGNUP=true
