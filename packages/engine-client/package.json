{
  "name": "@opensuite/engine-client",
  "version": "0.0.0",
  "private": true,
  "description": "The only application-layer package permitted to communicate with the opensuite-engine Rust service. See docs/engine_integration.md.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo \"(no lint configured yet)\"",
    "test": "tsc -p tsconfig.json && node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@opensuite/agent-core": "workspace:*",
    "@opensuite/contracts": "workspace:*"
  },
  "optionalDependencies": {
    "@opensuite/engine": "file:../../../opensuite-engine/crates/opensuite-node"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
